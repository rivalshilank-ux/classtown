# Copy to .env.local and fill in real values. Never commit .env.local.

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GAME_SERVER_URL=ws://localhost:2567

# Server-only — must never be prefixed with NEXT_PUBLIC_ or bundled to the client.
#
# Required by the student join action: students have no Supabase session of their
# own, so validating a class code and minting a join ticket has to happen under
# the service role. This key bypasses RLS, so every call made with it is the
# security boundary.
SUPABASE_SERVICE_ROLE_KEY=

# AI Ops (/admin/ai). Optional -- without it, /admin/ai renders a clear
# "not configured" state instead of failing. The browser never calls Groq
# directly; only server actions in apps/web/src/lib/ai/ do.
GROQ_API_KEY=
# Optional, defaults to llama-3.3-70b-versatile if unset.
GROQ_MODEL=

# Optional, used only by the get_git_changes AI Ops tool (read-only commit
# history via the GitHub REST API). Without it, that tool reports "not
# configured" instead of failing the whole AI Ops request.
GITHUB_TOKEN=

# Required for the hidden admin-login shortcut's Admin Code pre-gate
# (double-tap Shift+Cmd/Shift+Ctrl -> /admin/login). A SHA-256 hash, never
# the raw code -- generate it with:
#   pnpm --filter @classtown/web hash-admin-code -- "the-actual-code"
# Fails closed: with this unset, the code gate rejects every attempt rather
# than silently letting everyone through.
ADMIN_CODE_HASH=

# Vercel Cron sends this as `Authorization: Bearer $CRON_SECRET` to
# /api/cron/* routes -- required for those routes to accept a request.
# Without it, the routes reject every invocation (fails closed, same as
# ADMIN_CODE_HASH above).
CRON_SECRET=

# Phase 6 deployment pipeline (all optional -- without them, the relevant
# step reports "not configured" and the pipeline stops safely rather than
# faking success).
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_DEPLOY_HOOK_URL=
