# Copy to .env.local and fill in real values. Never commit .env.local.

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GAME_SERVER_URL=ws://localhost:2567

# Server-only — must never be prefixed with NEXT_PUBLIC_ or bundled to the client.
#
# Required by the student join action: students have no Supabase session of their
# own, so validating a class code and minting a join ticket has to happen under
# the service role. This key bypasses RLS, so every call made with it is the
# security boundary.
SUPABASE_SERVICE_ROLE_KEY=
