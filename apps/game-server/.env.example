# Copy to .env.local and fill in real values. Never commit .env.local.

PORT=2567

# Required. The game server verifies every join ticket against Supabase and is
# the only writer for student rows, so it starts with the service role and
# refuses to boot without these. A room that cannot verify a ticket must not
# accept players.
#
# Server-only — must never be exposed to any client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
